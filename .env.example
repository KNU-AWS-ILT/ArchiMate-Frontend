# Cognito 값은 인프라 1차 배포 후 전달받아 .env.local에 넣는다. (값은 커밋하지 않는다)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_DOMAIN=

# API 모드: mock이면 계약 예시로 동작하고, 비어 있으면 /api/v1 실제 API를 부른다.
# 목에서는 주소에 ?state=partial-failed 또는 ?state=failed를 붙여 실패 화면을 볼 수 있다.
NEXT_PUBLIC_API_MODE=
# 로컬 개발에서 배포된 API를 쓰려면 개발 서버가 /api/v1을 대신 넘겨 준다. (`pnpm dev`에서만 동작, 빌드에는 영향 없음)
# 예: 백엔드를 로컬로 띄웠다면 http://localhost:8000, 배포된 API를 쓰려면 CloudFront 주소
# 비워 두면 /api/v1을 그대로 호출하고, 받아 줄 서버가 없어서 실패한다. (NEXT_PUBLIC_API_MODE=mock이면 필요 없음)
API_PROXY_TARGET=
