{
    "name": "archimate-frontend",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@12.23.0",
    "engines": {
        "node": ">=26 <27"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "gen:api": "openapi-typescript contracts/openapi.json -o src/shared/api/schema.d.ts"
    },
    "dependencies": {
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.15.0",
        "eslint-config-next": "^16.4.6",
        "eslint-config-prettier": "^10.1.8",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.33",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "typescript": "~6.0.3",
        "vitest": "^5.1.1"
    }
}
