{
  "openapi": "3.1.0",
  "info": {
    "title": "ArchiMate API",
    "description": "ArchiMate 백엔드 API. 인터뷰 답변으로 AWS 구성 3안(최소비용·균형·확장형)과 월 비용, 운영 절차를 만든다.\n\n- 필드명은 camelCase, 열거형 값은 snake_case, 에러 `code`는 UPPER_SNAKE_CASE\n- 모든 에러는 `{ code, message, retryable, requestId }` 모양\n- 로컬 개발에서는 `X-User-Id` 헤더로 사용자를 구분한다 (Lambda에서는 Cognito 로그인 sub를 쓰고 헤더는 무시)\n",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "헬스 체크",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Gethealth"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/designs": {
      "post": {
        "tags": [
          "designs"
        ],
        "summary": "3안 생성 요청",
        "description": "인터뷰 답변으로 최소비용·균형·확장형 3안 생성을 시작하고 `jobId`를 바로 돌려준다.\n\n생성은 뒤에서 진행되므로(최대 약 3분) `GET /designs/jobs/{jobId}`로 상태를 조회한다.",
        "operationId": "createDesign",
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다",
              "title": "X-User-Id"
            },
            "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDesignRequest"
              },
              "examples": {
                "demo": {
                  "summary": "데모 시나리오: 동아리 모집 서비스",
                  "value": {
                    "answers": {
                      "serviceType": "web_app",
                      "concurrentUsers": "under_100",
                      "monthlyBudget": 50000,
                      "awsExperience": "none",
                      "dataStorage": [
                        "key_value"
                      ],
                      "trafficPattern": "spiky",
                      "availability": "best_effort",
                      "freeText": "바이브 코딩으로 만든 동아리 모집 사이트예요. 모집 기간에만 지원자가 몰려요."
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignJobAccepted"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패 (`INVALID_REQUEST`). 경로 id 길이 초과 포함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류 (`INTERNAL_ERROR`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/designs/jobs/{jobId}": {
      "get": {
        "tags": [
          "designs"
        ],
        "summary": "생성 작업 상태 조회",
        "description": "2~3초마다 호출한다. `status`가 `completed` 또는 `failed`가 되면 조회를 멈춘다.\n\n- `designs`: 끝난 안부터 채워진다\n- 일부 안만 실패: `status=completed`, 실패한 안은 `failures`\n- 모두 실패: `status=failed`, `error`에 사유 (HTTP는 200)",
        "operationId": "getDesignJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "생성 작업 id (POST 응답의 jobId)",
              "title": "Jobid"
            },
            "description": "생성 작업 id (POST 응답의 jobId)"
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다",
              "title": "X-User-Id"
            },
            "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesignJob"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패 (`INVALID_REQUEST`). 경로 id 길이 초과 포함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "job·설계·노드 없음 (`NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/designs/{designId}/guide": {
      "get": {
        "tags": [
          "designs"
        ],
        "summary": "배포·운영 절차 조회",
        "description": "3안 생성 때 함께 만든 절차를 조회만 한다. 생성 응답의 `designs[].operationsGuide`와 같은 값.",
        "operationId": "getOperationsGuide",
        "parameters": [
          {
            "name": "designId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 96,
              "description": "설계안 id (`designs[].id`, 예: job_..._minimal_cost)",
              "title": "Designid"
            },
            "description": "설계안 id (`designs[].id`, 예: job_..._minimal_cost)"
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다",
              "title": "X-User-Id"
            },
            "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationsGuide"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패 (`INVALID_REQUEST`). 경로 id 길이 초과 포함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "job·설계·노드 없음 (`NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/designs/{designId}/nodes/{nodeId}/explanation": {
      "get": {
        "tags": [
          "designs"
        ],
        "summary": "노드 설명 조회",
        "description": "노드를 클릭하면 '왜 이 서비스인가 / 대안 / 주의점'을 돌려준다. 처음 한 번은 AI가 생성하고(수 초) 이후에는 캐시를 쓴다.",
        "operationId": "getNodeExplanation",
        "parameters": [
          {
            "name": "designId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 96,
              "description": "설계안 id (`designs[].id`, 예: job_..._minimal_cost)",
              "title": "Designid"
            },
            "description": "설계안 id (`designs[].id`, 예: job_..._minimal_cost)"
          },
          {
            "name": "nodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "노드 id (`architecture.nodes[].id`)",
              "title": "Nodeid"
            },
            "description": "노드 id (`architecture.nodes[].id`)"
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다",
              "title": "X-User-Id"
            },
            "description": "로컬 개발 전용 임시 사용자 id. Lambda(API Gateway)에서는 무시하고 Cognito sub를 쓴다"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeExplanation"
                }
              }
            }
          },
          "400": {
            "description": "입력 검증 실패 (`INVALID_REQUEST`). 경로 id 길이 초과 포함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "job·설계·노드 없음 (`NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "요청 과다 (`RATE_LIMITED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AI 생성 실패 (`EXPLANATION_FAILED` 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "AI 응답 시간 초과 (`LLM_TIMEOUT`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alternative": {
        "properties": {
          "serviceType": {
            "$ref": "#/components/schemas/AwsService"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "comparison": {
            "type": "string",
            "title": "Comparison"
          }
        },
        "type": "object",
        "required": [
          "serviceType",
          "name",
          "comparison"
        ],
        "title": "Alternative"
      },
      "Architecture": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "title": "Edges"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/Group"
            },
            "type": "array",
            "title": "Groups"
          }
        },
        "type": "object",
        "required": [
          "nodes",
          "edges",
          "groups"
        ],
        "title": "Architecture",
        "description": "다이어그램 데이터. 좌표는 프론트가 그룹 구조로 자동 배치한다."
      },
      "AvailabilityNeed": {
        "type": "string",
        "enum": [
          "best_effort",
          "standard",
          "high"
        ],
        "title": "AvailabilityNeed"
      },
      "AwsExperience": {
        "type": "string",
        "enum": [
          "none",
          "beginner",
          "intermediate",
          "advanced"
        ],
        "title": "AwsExperience"
      },
      "AwsService": {
        "type": "string",
        "enum": [
          "users",
          "lambda",
          "s3",
          "dynamodb",
          "rds",
          "ec2",
          "cloudfront",
          "api_gateway",
          "alb",
          "ecs_fargate",
          "nat_gateway",
          "elasticache",
          "cognito",
          "route53",
          "sqs",
          "sns",
          "eventbridge",
          "cloudwatch",
          "secrets_manager",
          "ses",
          "bedrock"
        ],
        "title": "AwsService",
        "description": "다이어그램 노드의 서비스 종류 (JSON 필드 `serviceType`).\n\nLLM은 이 목록 밖의 서비스를 출력할 수 없다(스키마로 강제).\n프론트는 이 값으로 AWS 공식 아이콘을 매핑한다."
      },
      "Checklist": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "'cost'(비용 이상 대응) 또는 'incident'(장애 대응)"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "key",
          "title",
          "items"
        ],
        "title": "Checklist"
      },
      "CostItem": {
        "properties": {
          "nodeId": {
            "type": "string",
            "title": "Nodeid"
          },
          "amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount",
            "description": "월 비용(원). 원 단위 반올림"
          },
          "amountUsd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amountusd",
            "description": "월 비용(USD). 소수 둘째 자리 반올림"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "계산 근거 또는 계산하지 못한 이유"
          }
        },
        "type": "object",
        "required": [
          "nodeId",
          "amount",
          "amountUsd"
        ],
        "title": "CostItem",
        "description": "노드 1개의 월 비용. 계산 대상이 아니거나 사용량이 없으면 amount·amountUsd가 null."
      },
      "CreateDesignRequest": {
        "properties": {
          "answers": {
            "$ref": "#/components/schemas/Requirements"
          }
        },
        "type": "object",
        "required": [
          "answers"
        ],
        "title": "CreateDesignRequest"
      },
      "DataStorageNeed": {
        "type": "string",
        "enum": [
          "relational",
          "key_value",
          "file_storage",
          "none"
        ],
        "title": "DataStorageNeed"
      },
      "DesignJob": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "designs": {
            "items": {
              "$ref": "#/components/schemas/DesignResult"
            },
            "type": "array",
            "title": "Designs",
            "description": "끝난 안부터 채워짐"
          },
          "failures": {
            "items": {
              "$ref": "#/components/schemas/TierFailure"
            },
            "type": "array",
            "title": "Failures"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "status=failed일 때"
          }
        },
        "type": "object",
        "required": [
          "jobId",
          "status"
        ],
        "title": "DesignJob"
      },
      "DesignJobAccepted": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          }
        },
        "type": "object",
        "required": [
          "jobId"
        ],
        "title": "DesignJobAccepted"
      },
      "DesignResult": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "안 이름, 예: '서버리스 최소비용 구성'"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "구성 요약 1~2문장"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "architecture": {
            "$ref": "#/components/schemas/Architecture"
          },
          "pros": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pros",
            "description": "장점 2~4개"
          },
          "cons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cons",
            "description": "단점·한계 2~4개"
          },
          "budgetNote": {
            "type": "string",
            "title": "Budgetnote",
            "description": "예산 대비 적합성 코멘트. 금액 숫자는 쓰지 않는다"
          },
          "scalingPath": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scalingpath",
            "description": "성장 로드맵: 사용자 1만 명, 10만 명이 될 때 바꿀 부분 (단계별 1~3개)"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          },
          "operationsGuide": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OperationsGuide"
              },
              {
                "type": "null"
              }
            ],
            "description": "이 안의 배포·운영 절차. 생성에 실패하면 null"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "description": "안 id. C·D 조회 경로에 쓴다"
          },
          "monthlyCost": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MonthlyCost"
              },
              {
                "type": "null"
              }
            ],
            "description": "API·비용 담당이 채움"
          }
        },
        "type": "object",
        "required": [
          "title",
          "summary",
          "difficulty",
          "architecture",
          "pros",
          "cons",
          "budgetNote",
          "scalingPath",
          "tier",
          "id"
        ],
        "title": "DesignResult",
        "description": "3안 중 1안 = LLM 설계(Design) + 저장 id + 월 비용."
      },
      "Difficulty": {
        "properties": {
          "level": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Level",
            "description": "운영 난이도 1(쉬움)~3(어려움)"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "이 난이도인 이유 한 줄"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "level",
          "reason",
          "label"
        ],
        "title": "Difficulty"
      },
      "Edge": {
        "properties": {
          "from": {
            "type": "string",
            "title": "From",
            "description": "출발 노드 id"
          },
          "to": {
