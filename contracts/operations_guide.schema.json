      "properties": {
        "id": {
          "description": "절차 id. 영문 소문자·숫자·밑줄, 안 안에서 고유 (완료 체크 저장 키)",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "desc": {
          "description": "무엇을 왜 하는지 1~2문장",
          "title": "Desc",
          "type": "string"
        },
        "nodeIds": {
